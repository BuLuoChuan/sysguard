<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>SysGuard</vendor>
  <action id="com.sysguard.privileged">
    <description>运行系统管理特权命令</description>
    <description xml:lang="zh_CN">运行系统管理特权命令</description>
    <message>系统管家需要授权以执行受保护的系统操作</message>
    <message xml:lang="zh_CN">系统管家需要授权以执行受保护的系统操作</message>
    <icon_name>utilities-system-monitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/sysguard-cli</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>